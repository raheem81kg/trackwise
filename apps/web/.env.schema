# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# Google OAuth credentials (console.cloud.google.com > APIs & Services > Credentials).
# Client ID is an identifier embedded in OAuth URLs — not a secret.
# @required=false @sensitive=false @type=string(minLength=1)
GOOGLE_CLIENT_ID=

# @required=false @type=string(minLength=1)
GOOGLE_CLIENT_SECRET=

# @type=string(minLength=1)
DATABASE_URL=

# @required=false @type=string(minLength=1)
DATABASE_URL_DIRECT=

# Access key ID, endpoint, region and bucket all appear inside presigned
# URLs (X-Amz-Credential / path). Marking them non-sensitive stops varlock's
# leak detection from mangling the URLs returned to the browser. They are
# identifiers, not secrets — the signing secret below stays sensitive.
# @required=false @sensitive=false @type=string(minLength=1)
AWS_ACCESS_KEY_ID=

# @required=false @type=string(minLength=1)
AWS_SECRET_ACCESS_KEY=

# @required=false @sensitive=false @type=url
AWS_ENDPOINT_URL_S3=

# @required=false @sensitive=false @type=string(minLength=1)
AWS_REGION=

# @required=false @sensitive=false @type=string(minLength=1)
AWS_S3_BUCKET=task-attachments
