{
	"name": "trackwise",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"db:push": "turbo run db:push -F @trackwise/db --",
		"db:studio": "turbo run db:studio -F @trackwise/db --",
		"db:generate": "turbo run db:generate -F @trackwise/db --",
		"db:migrate": "turbo run db:migrate -F @trackwise/db --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/web && pnpm run auth:generate",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@trackwise/config": "workspace:*",
		"@types/node": "catalog:",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "pnpm@12.11.2"
}
